<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تحويل إلى CRM الجديد...</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #1a1f2e 0%, #252b3d 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .redirect-container {
            text-align: center;
            color: #ccd6f6;
            animation: fadeIn 0.5s ease-in;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .redirect-icon {
            font-size: 80px;
            margin-bottom: 20px;
            animation: pulse 1.5s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        h1 {
            font-size: 32px;
            margin-bottom: 15px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        p {
            font-size: 18px;
            color: #a8b2d1;
            margin-bottom: 30px;
        }

        .spinner {
            width: 50px;
            height: 50px;
            margin: 0 auto;
            border: 4px solid rgba(102, 126, 234, 0.2);
            border-top-color: #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .features {
            margin-top: 30px;
            font-size: 14px;
            color: #8892b0;
        }

        .feature-item {
            display: inline-block;
            margin: 5px 15px;
        }

        .feature-item::before {
            content: '✓';
            color: #43e97b;
            margin-left: 8px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="redirect-container">
        <div class="redirect-icon">🚀</div>
        <h1>نظام CRM المتطور</h1>
        <p>جاري التحويل إلى الواجهة الجديدة...</p>
        <div class="spinner"></div>
        
        <div class="features">
            <div class="feature-item">Dark Theme احترافي</div>
            <div class="feature-item">Avatars متعددة ملونة</div>
            <div class="feature-item">6 أزرار إجراءات</div>
            <div class="feature-item">نظام التقييم بالنجوم</div>
            <div class="feature-item">WhatsApp Integration</div>
        </div>
    </div>

    <script>
        // تحويل تلقائي بعد ثانية واحدة
        setTimeout(() => {
            // الحصول على بيانات الجلسة من localStorage أو sessionStorage
            const companyId = sessionStorage.getItem('companyId') || localStorage.getItem('companyId');
            
            if (companyId) {
                // التحويل مع فتح قسم جهات الاتصال مباشرة
                window.location.href = '/index.html#contacts';
            } else {
                // إذا لم يكن هناك بيانات تسجيل دخول، العودة للصفحة الرئيسية
                window.location.href = '/index.html';
            }
        }, 1000);
    </script>
</body>
</html>

        /* خلفية متحركة */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, 
                rgba(10, 22, 40, 0.95) 0%, 
                rgba(30, 58, 95, 0.90) 50%, 
                rgba(10, 22, 40, 0.95) 100%);
            z-index: 0;
            pointer-events: none;
        }

        body::after {
            content: '';
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background-image: 
                radial-gradient(2px 2px at 20px 30px, rgba(94, 196, 212, 0.6), transparent),
                radial-gradient(2px 2px at 60px 70px, rgba(94, 196, 212, 0.4), transparent),
                radial-gradient(1px 1px at 50px 50px, rgba(94, 196, 212, 0.5), transparent);
            background-repeat: repeat;
            background-size: 300px 200px;
            animation: starsAnimation 100s linear infinite;
            opacity: 0.4;
            pointer-events: none;
            z-index: 0;
        }

        @keyframes starsAnimation {
            0% { transform: translateY(0); }
            100% { transform: translateY(-200px); }
        }

        .container {
            max-width: 1800px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        .header {
            background: rgba(255, 255, 255, 0.98);
            padding: 25px 35px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3), 0 0 20px rgba(94, 196, 212, 0.1);
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(94, 196, 212, 0.2);
        }

        .header h1 {
            color: #1e3a5f;
            font-size: 32px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .header-actions {
            display: flex;
            gap: 15px;
        }

        .btn {
            padding: 12px 30px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
        }

        .btn-primary {
            background: linear-gradient(135deg, #5ec4d4 0%, #1e88a8 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(94, 196, 212, 0.3);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(94, 196, 212, 0.5);
        }

        .btn-success {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.5);
        }

        .crm-grid {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 25px;
            margin-bottom: 30px;
        }

        .sidebar {
            background: rgba(255, 255, 255, 0.98);
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(94, 196, 212, 0.15);
            height: fit-content;
        }

        .sidebar h3 {
            color: #1e3a5f;
            margin-bottom: 20px;
            font-size: 18px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pipeline-stage {
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .pipeline-stage:hover {
            transform: translateX(-5px);
        }

        .pipeline-stage.active {
            box-shadow: 0 4px 15px rgba(94, 196, 212, 0.3);
        }

        .stage-new {
            background: linear-gradient(135deg, #dbeafe 0%, #93c5fd 100%);
            color: #1e40af;
        }

        .stage-contacted {
            background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
            color: #92400e;
        }

        .stage-qualified {
            background: linear-gradient(135deg, #d1fae5 0%, #6ee7b7 100%);
            color: #065f46;
        }

        .stage-proposal {
            background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
            color: #3730a3;
        }

        .stage-won {
            background: linear-gradient(135deg, #d1fae5 0%, #34d399 100%);
            color: #064e3b;
        }

        .stage-lost {
            background: linear-gradient(135deg, #fee2e2 0%, #fca5a5 100%);
            color: #991b1b;
        }

        .stage-count {
            background: rgba(255,255,255,0.9);
            padding: 5px 12px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 14px;
        }

        .main-content {
            background: rgba(255, 255, 255, 0.98);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(94, 196, 212, 0.2);
        }

        .search-bar {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
        }

        .search-bar input {
            flex: 1;
            padding: 12px 20px;
            border: 2px solid #e5e7eb;
            border-radius: 25px;
            font-size: 16px;
            transition: all 0.3s;
        }

        .search-bar input:focus {
            outline: none;
            border-color: #5ec4d4;
            box-shadow: 0 0 15px rgba(94, 196, 212, 0.2);
        }

        .leads-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
            margin-top: 25px;
        }

        .lead-card {
            background: white;
            border: 2px solid #e5e7eb;
            border-radius: 15px;
            padding: 20px;
            transition: all 0.3s;
            cursor: pointer;
        }

        .lead-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            border-color: #5ec4d4;
        }

        .lead-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .lead-name {
            font-size: 20px;
            font-weight: bold;
            color: #1e3a5f;
            margin-bottom: 5px;
        }

        .lead-company {
            color: #6b7280;
            font-size: 14px;
        }

        .lead-value {
            background: linear-gradient(135deg, #d1fae5 0%, #6ee7b7 100%);
            color: #065f46;
            padding: 8px 15px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 14px;
        }

        .lead-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin: 15px 0;
            padding: 15px;
            background: #f9fafb;
            border-radius: 10px;
        }

        .info-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #6b7280;
        }

        .lead-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
        }

        .action-btn {
            flex: 1;
            padding: 10px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-call {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
        }

        .btn-email {
            background: linear-gradient(135deg, #5ec4d4 0%, #1e88a8 100%);
            color: white;
        }

        .btn-edit {
            background: linear-gradient(135deg, #fde68a 0%, #f59e0b 100%);
            color: #78350f;
        }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            justify-content: center;
            align-items: center;
            z-index: 10000;
            overflow-y: auto;
            padding: 20px;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: white;
            padding: 40px;
            border-radius: 20px;
            max-width: 700px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #e5e7eb;
        }

        .modal-header h2 {
            color: #1e3a5f;
            font-size: 26px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .btn-close {
            background: #fee2e2;
            color: #991b1b;
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            font-size: 24px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn-close:hover {
            background: #fca5a5;
            transform: rotate(90deg);
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            margin-bottom: 8px;
            font-weight: 600;
            color: #1e3a5f;
            font-size: 14px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 12px 15px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            font-size: 15px;
            transition: all 0.3s;
            font-family: inherit;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #5ec4d4;
            box-shadow: 0 0 15px rgba(94, 196, 212, 0.2);
        }

        .form-group textarea {
            resize: vertical;
            min-height: 100px;
        }

        .empty-state {
            text-align: center;
            padding: 80px 20px;
        }

        .empty-state-icon {
            font-size: 80px;
            margin-bottom: 20px;
            opacity: 0.3;
        }

        .empty-state h3 {
            color: #6b7280;
            font-size: 22px;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: #9ca3af;
            font-size: 16px;
        }

        @media (max-width: 1200px) {
            .crm-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .leads-grid {
                grid-template-columns: 1fr;
            }
            
            .form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>
                <span>🎯</span> نظام إدارة العملاء CRM
            </h1>
            <div class="header-actions">
                <!-- تبويبات -->
                <button id="tab-leads-btn" class="btn btn-primary" onclick="switchTab('leads')" style="background: linear-gradient(135deg,#5ec4d4,#1e88a8);">
                    🎯 العملاء المحتملون
                </button>
                <button id="tab-contacts-btn" class="btn btn-secondary" onclick="switchTab('contacts')" style="background:#e5e7eb;color:#374151;">
                    👥 جهات الاتصال
                </button>
                <button id="tab-add-btn" class="btn btn-success" onclick="showAddLeadModal()" style="">
                    ➕ إضافة عميل محتمل
                </button>
                <a href="index.html" class="btn btn-primary">⬅️ العودة</a>
            </div>
        </div>

        <!-- Main Content - Leads -->
        <div id="leads-panel">
        <div class="crm-grid">
            <!-- Sidebar - Pipeline Stages -->
            <div class="sidebar">
                <h3>
                    <span>📊</span> مراحل البيع
                </h3>
                <div class="pipeline-stage stage-new active" data-stage="new" onclick="filterByStage('new')">
                    <span>🆕 عملاء جدد</span>
                    <span class="stage-count" id="count-new">0</span>
                </div>
                <div class="pipeline-stage stage-contacted" data-stage="contacted" onclick="filterByStage('contacted')">
                    <span>📞 تم التواصل</span>
                    <span class="stage-count" id="count-contacted">0</span>
                </div>
                <div class="pipeline-stage stage-qualified" data-stage="qualified" onclick="filterByStage('qualified')">
                    <span>✅ عميل مؤهل</span>
                    <span class="stage-count" id="count-qualified">0</span>
                </div>
                <div class="pipeline-stage stage-proposal" data-stage="proposal" onclick="filterByStage('proposal')">
                    <span>📝 عرض سعر</span>
                    <span class="stage-count" id="count-proposal">0</span>
                </div>
                <div class="pipeline-stage stage-won" data-stage="won" onclick="filterByStage('won')">
                    <span>🎉 تم الإغلاق</span>
                    <span class="stage-count" id="count-won">0</span>
                </div>
                <div class="pipeline-stage stage-lost" data-stage="lost" onclick="filterByStage('lost')">
                    <span>❌ فُقد</span>
                    <span class="stage-count" id="count-lost">0</span>
                </div>

                <div style="margin-top: 30px; padding-top: 20px; border-top: 2px solid #e5e7eb;">
                    <h3 style="margin-bottom: 15px;">
                        <span>💰</span> الإحصائيات
                    </h3>
                    <div style="background: linear-gradient(135deg, #d1fae5 0%, #6ee7b7 100%); padding: 15px; border-radius: 10px; margin-bottom: 12px;">
                        <div style="font-size: 12px; color: #065f46; margin-bottom: 5px;">إجمالي القيمة المتوقعة</div>
                        <div style="font-size: 24px; font-weight: bold; color: #064e3b;" id="totalValue">0 ريال</div>
                    </div>
                    <div style="background: linear-gradient(135deg, #dbeafe 0%, #93c5fd 100%); padding: 15px; border-radius: 10px;">
                        <div style="font-size: 12px; color: #1e40af; margin-bottom: 5px;">معدل التحويل</div>
                        <div style="font-size: 24px; font-weight: bold; color: #1e3a8a;" id="conversionRate">0%</div>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="main-content">
                <div class="search-bar">
                    <input type="text" id="searchInput" placeholder="🔍 ابحث عن عميل..." onkeyup="searchLeads()">
                    <select id="sortBy" onchange="sortLeads()" style="padding: 12px 20px; border: 2px solid #e5e7eb; border-radius: 25px; font-size: 16px; cursor: pointer;">
                        <option value="date-desc">الأحدث أولاً</option>
                        <option value="date-asc">الأقدم أولاً</option>
                        <option value="value-desc">الأعلى قيمة</option>
                        <option value="value-asc">الأقل قيمة</option>
                    </select>
                </div>

                <div class="leads-grid" id="leadsContainer">
                    <!-- Leads will be populated here -->
                </div>
            </div>
        </div>
        </div><!-- /leads-panel -->

        <!-- Contacts Panel - جهات الاتصال من Firestore (نفس مصدر التطبيق الرئيسي) -->
        <div id="contacts-panel" style="display:none;">
            <div class="main-content">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
                    <h2 style="color:#1e3a5f; font-size:22px;">👥 جهات الاتصال <span style="font-size:14px;color:#6b7280;font-weight:normal;">(مشتركة مع التطبيق الرئيسي - تُحفظ في Firestore)</span></h2>
                    <button class="btn btn-success" onclick="showAddContactCRM()">➕ إضافة جهة اتصال</button>
                </div>
                <div style="margin-bottom:20px;">
                    <input type="text" id="crm-contact-search" placeholder="🔍 ابحث عن اسم أو رقم..."
                        oninput="filterCRMContacts()"
                        style="width:100%; padding:12px 20px; border:2px solid #e5e7eb; border-radius:25px; font-size:16px; transition:all 0.3s; font-family:inherit;"
                        onfocus="this.style.borderColor='#5ec4d4'" onblur="this.style.borderColor='#e5e7eb'">
                </div>
                <div id="crm-contacts-container">
                    <div style="text-align:center; padding:80px 20px;">
                        <div style="font-size:60px; opacity:0.3; margin-bottom:15px;">👥</div>
                        <p style="color:#9ca3af;">جاري تحميل جهات الاتصال...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add/Edit Lead Modal -->
    <div class="modal" id="leadModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">
                    <span>➕</span> إضافة عميل محتمل جديد
                </h2>
                <button class="btn-close" onclick="closeModal()">&times;</button>
            </div>

            <form id="leadForm" onsubmit="saveLead(event)">
                <input type="hidden" id="leadId">
                
                <div class="form-grid">
                    <div class="form-group">
                        <label>👤 اسم العميل *</label>
                        <input type="text" id="leadName" required placeholder="أحمد محمد">
                    </div>
                    <div class="form-group">
                        <label>🏢 الشركة</label>
                        <input type="text" id="leadCompany" placeholder="شركة المستقبل">
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>📞 رقم الهاتف *</label>
                        <input type="tel" id="leadPhone" required placeholder="+966 5x xxx xxxx">
                    </div>
                    <div class="form-group">
                        <label>📧 البريد الإلكتروني</label>
                        <input type="email" id="leadEmail" placeholder="client@company.com">
                    </div>
                </div>

                <div class="form-grid">
                    <div class="form-group">
                        <label>💰 القيمة المتوقعة (ريال)</label>
                        <input type="number" id="leadValue" min="0" value="0" placeholder="10000">
                    </div>
                    <div class="form-group">
                        <label>📊 المرحلة</label>
                        <select id="leadStage" required>
                            <option value="new">🆕 عميل جديد</option>
                            <option value="contacted">📞 تم التواصل</option>
                            <option value="qualified">✅ عميل مؤهل</option>
                            <option value="proposal">📝 عرض سعر</option>
                            <option value="won">🎉 تم الإغلاق</option>
                            <option value="lost">❌ فُقد</option>
                        </select>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label>📝 ملاحظات</label>
                    <textarea id="leadNotes" placeholder="أضف أي ملاحظات هنا..."></textarea>
                </div>

                <div style="display: flex; gap: 15px; margin-top: 25px;">
                    <button type="button" onclick="closeModal()" class="btn btn-secondary" style="flex: 1; background: #e5e7eb; color: #374151; padding: 14px;">
                        إلغاء
                    </button>
                    <button type="submit" class="btn btn-success" style="flex: 2; padding: 14px;">
                        💾 حفظ العميل
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let companyId = null;
        let allLeads = [];
        let currentStage = 'all';
        // ─── Contacts ───────────────────────────────────────────────
        let _crmCachedContacts = [];

        window.addEventListener('DOMContentLoaded', async () => {
            companyId = sessionStorage.getItem('companyId');
            
            if (!companyId) {
                alert('لم يتم العثور على معلومات الشركة. يرجى تسجيل الدخول أولاً');
                window.location.href = 'login.html';
                return;
            }

            await loadLeads();
        });

        // ─── تبديل التبويبات ─────────────────────────────────────────
        function switchTab(tab) {
            const leadsPanel    = document.getElementById('leads-panel');
            const contactsPanel = document.getElementById('contacts-panel');
            const leadsBtn      = document.getElementById('tab-leads-btn');
            const contactsBtn   = document.getElementById('tab-contacts-btn');
            const addBtn        = document.getElementById('tab-add-btn');

            if (tab === 'leads') {
                leadsPanel.style.display    = '';
                contactsPanel.style.display = 'none';
                leadsBtn.style.background   = 'linear-gradient(135deg,#5ec4d4,#1e88a8)';
                leadsBtn.style.color        = 'white';
                contactsBtn.style.background= '#e5e7eb';
                contactsBtn.style.color     = '#374151';
                addBtn.style.display        = '';
            } else {
                leadsPanel.style.display    = 'none';
                contactsPanel.style.display = '';
                contactsBtn.style.background= 'linear-gradient(135deg,#5ec4d4,#1e88a8)';
                contactsBtn.style.color     = 'white';
                leadsBtn.style.background   = '#e5e7eb';
                leadsBtn.style.color        = '#374151';
                addBtn.style.display        = 'none';
                loadCRMContacts(); // تحميل جهات الاتصال عند الانتقال لهذا التبويب
            }
        }

        // ─── جهات الاتصال: جلب من Firestore (نفس API التطبيق الرئيسي) ─
        async function loadCRMContacts() {
            const container = document.getElementById('crm-contacts-container');
            container.innerHTML = '<div style="text-align:center;padding:60px;color:#9ca3af;">⏳ جاري التحميل...</div>';

            try {
                const apiBase = window.location.origin;
                const res  = await fetch(`${apiBase}/api/contacts?companyId=${encodeURIComponent(companyId)}`);
                const data = await res.json();
                _crmCachedContacts = data.contacts || [];
                renderCRMContacts(_crmCachedContacts);
            } catch (err) {
                console.error('خطأ في تحميل جهات الاتصال:', err);
                container.innerHTML = '<p style="text-align:center;color:#f44336;padding:40px;">خطأ في تحميل البيانات</p>';
            }
        }

        function renderCRMContacts(list) {
            const container = document.getElementById('crm-contacts-container');
            if (!list || list.length === 0) {
                container.innerHTML = `
                    <div style="text-align:center;padding:80px 20px;">
                        <div style="font-size:70px;opacity:0.3;margin-bottom:15px;">👥</div>
                        <h3 style="color:#6b7280;">لا توجد جهات اتصال بعد</h3>
                        <p style="color:#9ca3af;margin-bottom:20px;">أضف جهات الاتصال من التطبيق الرئيسي أو من هنا</p>
                        <button class="btn btn-success" onclick="showAddContactCRM()">➕ إضافة أول جهة اتصال</button>
                    </div>`;
                return;
            }

            container.innerHTML = `
                <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:15px;">
                    ${list.map(c => {
                        const initial = (c.name||'؟').charAt(0).toUpperCase();
                        const cid = (c._id||c.id||'').replace(/'/g,'');
                        const safeName  = (c.name||'').replace(/"/g,'&quot;');
                        const safePhone = (c.phone||'').replace(/'/g,'');
                        const callHistory = c.totalCalls || 0;
                        return `
                        <div style="background:white;border:2px solid #e5e7eb;border-radius:12px;padding:18px;transition:all 0.3s;"
                             onmouseover="this.style.borderColor='#5ec4d4';this.style.boxShadow='0 5px 15px rgba(94,196,212,0.2)'"
                             onmouseout="this.style.borderColor='#e5e7eb';this.style.boxShadow='none'">
                            <div style="display:flex;align-items:center;gap:14px;margin-bottom:12px;">
                                <div style="width:48px;height:48px;background:linear-gradient(135deg,#5ec4d4,#1e88a8);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-weight:bold;font-size:20px;flex-shrink:0;">
                                    ${initial}
                                </div>
                                <div>
                                    <div style="font-size:17px;font-weight:bold;color:#1e3a5f;">${c.name||''}</div>
                                    <div style="font-size:14px;color:#6b7280;">${c.phone||''}</div>
                                </div>
                            </div>
                            ${c.email ? `<div style="font-size:13px;color:#6b7280;margin-bottom:8px;">📧 ${c.email}</div>` : ''}
                            ${c.notes ? `<div style="background:#f9fafb;padding:8px;border-radius:8px;font-size:13px;color:#6b7280;margin-bottom:10px;">${c.notes}</div>` : ''}
                            <div style="display:flex;gap:8px;font-size:12px;color:#9ca3af;margin-bottom:12px;">
                                <span>📞 ${callHistory} مكالمة</span>
                                ${c.createdAt ? `<span>📅 ${new Date(c.createdAt).toLocaleDateString('ar-EG')}</span>` : ''}
                            </div>
                            <div style="display:flex;gap:8px;">
                                <button onclick="crmCallContact('${safePhone}')"
                                    style="flex:1;padding:9px;background:linear-gradient(135deg,#10b981,#059669);color:white;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;">
                                    📞 اتصال
                                </button>
                                <button onclick="importContactAsLead('${cid}', '${safeName.replace(/'/g,'&#39;')}', '${safePhone}')"
                                    style="flex:1;padding:9px;background:linear-gradient(135deg,#fde68a,#f59e0b);color:#78350f;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;">
                                    🎯 تحويل لعميل
                                </button>
                            </div>
                        </div>`;
                    }).join('')}
                </div>
            `;
        }

        function filterCRMContacts() {
            const q = document.getElementById('crm-contact-search').value.toLowerCase().trim();
            if (!q) { renderCRMContacts(_crmCachedContacts); return; }
            const filtered = _crmCachedContacts.filter(c =>
                (c.name||'').toLowerCase().includes(q) || (c.phone||'').includes(q)
            );
            renderCRMContacts(filtered);
        }

        // ─── إضافة جهة اتصال من CRM ─────────────────────────────────
        async function showAddContactCRM() {
            const name  = prompt('اسم جهة الاتصال:');
            if (!name || !name.trim()) return;
            const phone = prompt('رقم الهاتف:');
            if (!phone || !phone.trim()) return;
            const email = prompt('البريد الإلكتروني (اختياري):') || '';
            const notes = prompt('ملاحظات (اختياري):') || '';

            try {
                const apiBase = window.location.origin;
                const res = await fetch(`${apiBase}/api/contacts`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        companyId,
                        name: name.trim(), phone: phone.trim(),
                        email: email.trim(), notes: notes.trim(),
                        addedBy: sessionStorage.getItem('username') || 'crm',
                        device: 'crm'
                    })
                });
                const data = await res.json();
                if (res.ok && data.success) {
                    alert('✅ تمت إضافة جهة الاتصال بنجاح وستظهر في التطبيق الرئيسي أيضاً');
                    loadCRMContacts();
                } else {
                    alert('⚠️ ' + (data.error || 'فشل في الإضافة'));
                }
            } catch(e) {
                alert('خطأ: ' + e.message);
            }
        }

        // ─── الاتصال من CRM ───────────────────────────────────────────
        function crmCallContact(phone) {
            window.location.href = `tel:${phone}`;
        }

        // ─── تحويل جهة الاتصال إلى عميل محتمل ──────────────────────
        function importContactAsLead(contactId, contactName, contactPhone) {
            switchTab('leads');
            // فتح modal الإضافة مع ملء البيانات
            showAddLeadModal();
            setTimeout(() => {
                const nameEl  = document.getElementById('leadName');
                const phoneEl = document.getElementById('leadPhone');
                if (nameEl)  nameEl.value  = contactName;
                if (phoneEl) phoneEl.value = contactPhone;
            }, 50);
        }
        // ─────────────────────────────────────────────────────────────

        async function loadLeads() {
            try {
                // Load from localStorage for now (later connect to API)
                const savedLeads = localStorage.getItem(`crm_leads_${companyId}`);
                allLeads = savedLeads ? JSON.parse(savedLeads) : [];
                
                updateCounts();
                renderLeads();
            } catch (error) {
                console.error('Error loading leads:', error);
            }
        }

        function updateCounts() {
            const counts = {
                new: 0,
                contacted: 0,
                qualified: 0,
                proposal: 0,
                won: 0,
                lost: 0
            };

            let totalValue = 0;
            let wonCount = 0;

            allLeads.forEach(lead => {
                counts[lead.stage] = (counts[lead.stage] || 0) + 1;
                totalValue += parseFloat(lead.value || 0);
                if (lead.stage === 'won') wonCount++;
            });

            // Update UI
            document.getElementById('count-new').textContent = counts.new;
            document.getElementById('count-contacted').textContent = counts.contacted;
            document.getElementById('count-qualified').textContent = counts.qualified;
            document.getElementById('count-proposal').textContent = counts.proposal;
            document.getElementById('count-won').textContent = counts.won;
            document.getElementById('count-lost').textContent = counts.lost;

            document.getElementById('totalValue').textContent = totalValue.toLocaleString() + ' ريال';
            
            const conversionRate = allLeads.length > 0 ? (wonCount / allLeads.length * 100).toFixed(1) : 0;
            document.getElementById('conversionRate').textContent = conversionRate + '%';
        }

        function renderLeads() {
            const container = document.getElementById('leadsContainer');
            let filteredLeads = currentStage === 'all' 
                ? allLeads 
                : allLeads.filter(lead => lead.stage === currentStage);

            // Apply search
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            if (searchTerm) {
                filteredLeads = filteredLeads.filter(lead =>
                    lead.name.toLowerCase().includes(searchTerm) ||
                    (lead.company && lead.company.toLowerCase().includes(searchTerm)) ||
                    lead.phone.includes(searchTerm)
                );
            }

            if (filteredLeads.length === 0) {
                container.innerHTML = `
                    <div class="empty-state" style="grid-column: 1 / -1;">
                        <div class="empty-state-icon">🎯</div>
                        <h3>لا توجد عملاء بعد</h3>
                        <p>ابدأ بإضافة أول عميل محتمل لشركتك</p>
                    </div>
                `;
                return;
            }

            const stageNames = {
                new: 'عميل جديد',
                contacted: 'تم التواصل',
                qualified: 'مؤهل',
                proposal: 'عرض سعر',
                won: 'تم الإغلاق',
                lost: 'فُقد'
            };

            container.innerHTML = filteredLeads.map(lead => `
                <div class="lead-card" onclick="editLead('${lead.id}')">
                    <div class="lead-header">
                        <div>
                            <div class="lead-name">${lead.name}</div>
                            <div class="lead-company">${lead.company || 'بدون شركة'}</div>
                        </div>
                        <div class="lead-value">${parseFloat(lead.value || 0).toLocaleString()} ريال</div>
                    </div>

                    <div class="lead-info">
                        <div class="info-item">
                            <span>📞</span>
                            <span>${lead.phone}</span>
                        </div>
                        <div class="info-item">
                            <span>📧</span>
                            <span>${lead.email || 'لا يوجد'}</span>
                        </div>
                        <div class="info-item">
                            <span>📊</span>
                            <span>${stageNames[lead.stage]}</span>
                        </div>
                        <div class="info-item">
                            <span>📅</span>
                            <span>${new Date(lead.createdAt).toLocaleDateString('ar-EG')}</span>
                        </div>
                    </div>

                    ${lead.notes ? `<div style="background: #f9fafb; padding: 12px; border-radius: 8px; margin: 10px 0; font-size: 14px; color: #6b7280;">${lead.notes}</div>` : ''}

                    <div class="lead-actions" onclick="event.stopPropagation()">
                        <button class="action-btn btn-call" onclick="callLead('${lead.phone}')" title="اتصال">📞</button>
                        <button class="action-btn btn-email" onclick="emailLead('${lead.email}')" title="بريد">📧</button>
                        <button class="action-btn btn-edit" onclick="editLead('${lead.id}')" title="تعديل">✏️</button>
                    </div>
                </div>
            `).join('');
        }

        function filterByStage(stage) {
            currentStage = stage;
            
            // Update UI
            document.querySelectorAll('.pipeline-stage').forEach(el => {
                el.classList.remove('active');
            });
            document.querySelector(`[data-stage="${stage}"]`).classList.add('active');

            renderLeads();
        }

        function searchLeads() {
            renderLeads();
        }

        function sortLeads() {
            const sortBy = document.getElementById('sortBy').value;
            
            switch(sortBy) {
                case 'date-desc':
                    allLeads.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
                    break;
                case 'date-asc':
                    allLeads.sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt));
                    break;
                case 'value-desc':
                    allLeads.sort((a, b) => parseFloat(b.value || 0) - parseFloat(a.value || 0));
                    break;
                case 'value-asc':
                    allLeads.sort((a, b) => parseFloat(a.value || 0) - parseFloat(b.value || 0));
                    break;
            }
            
            renderLeads();
        }

        function showAddLeadModal() {
            document.getElementById('modalTitle').innerHTML = '<span>➕</span> إضافة عميل محتمل جديد';
            document.getElementById('leadForm').reset();
            document.getElementById('leadId').value = '';
            document.getElementById('leadModal').classList.add('active');
        }

        function editLead(leadId) {
            const lead = allLeads.find(l => l.id === leadId);
            if (!lead) return;

            document.getElementById('modalTitle').innerHTML = '<span>✏️</span> تعديل بيانات العميل';
            document.getElementById('leadId').value = lead.id;
            document.getElementById('leadName').value = lead.name;
            document.getElementById('leadCompany').value = lead.company || '';
            document.getElementById('leadPhone').value = lead.phone;
            document.getElementById('leadEmail').value = lead.email || '';
            document.getElementById('leadValue').value = lead.value || 0;
            document.getElementById('leadStage').value = lead.stage;
            document.getElementById('leadNotes').value = lead.notes || '';
            
            document.getElementById('leadModal').classList.add('active');
        }

        function saveLead(event) {
            event.preventDefault();

            const leadId = document.getElementById('leadId').value;
            const isEdit = !!leadId;

            const leadData = {
                id: leadId || 'LEAD-' + Date.now(),
                companyId: companyId,
                name: document.getElementById('leadName').value,
                company: document.getElementById('leadCompany').value,
                phone: document.getElementById('leadPhone').value,
                email: document.getElementById('leadEmail').value,
                value: document.getElementById('leadValue').value,
                stage: document.getElementById('leadStage').value,
                notes: document.getElementById('leadNotes').value,
                createdAt: isEdit ? allLeads.find(l => l.id === leadId).createdAt : new Date().toISOString(),
                updatedAt: new Date().toISOString()
            };

            if (isEdit) {
                const index = allLeads.findIndex(l => l.id === leadId);
                allLeads[index] = leadData;
            } else {
                allLeads.push(leadData);
            }

            // Save to localStorage (later connect to API)
            localStorage.setItem(`crm_leads_${companyId}`, JSON.stringify(allLeads));

            closeModal();
            loadLeads();
            
            alert(isEdit ? 'تم تحديث بيانات العميل بنجاح!' : 'تم إضافة العميل بنجاح!');
        }

        function closeModal() {
            document.getElementById('leadModal').classList.remove('active');
        }

        function callLead(phone) {
            window.location.href = `tel:${phone}`;
        }

        function emailLead(email) {
            if (email) {
                window.location.href = `mailto:${email}`;
            } else {
                alert('لا يوجد بريد إلكتروني لهذا العميل');
            }
        }
    </script>
</body>
</html>
