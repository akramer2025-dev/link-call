{
  "version": 2,
  "name": "link-call",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*\\.(css|js|json|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webmanifest))",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(platform|login|admin|register-company|super-admin|direct-call|test-crm-integration)\\.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/login",
      "dest": "/api/index"
    },
    {
      "src": "/employees",
      "dest": "/api/index"
    },
    {
      "src": "/employees/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/work-tracking",
      "dest": "/api/index"
    },
    {
      "src": "/token",
      "dest": "/api/index"
    },
    {
      "src": "/voice",
      "dest": "/api/index"
    },
    {
      "src": "/recordings",
      "dest": "/api/index"
    },
    {
      "src": "/recordings/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/contacts",
      "dest": "/api/index"
    },
    {
      "src": "/contacts/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/call-history",
      "dest": "/api/index"
    },
    {
      "src": "/track-login",
      "dest": "/api/index"
    },
    {
      "src": "/track-logout",
      "dest": "/api/index"
    },
    {
      "src": "/heartbeat",
      "dest": "/api/index"
    },
    {
      "src": "/online-users",
      "dest": "/api/index"
    },
    {
      "src": "/settings",
      "dest": "/api/index"
    },
    {
      "src": "/account/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/companies",
      "dest": "/api/index"
    },
    {
      "src": "/companies/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/update-profile",
      "dest": "/api/index"
    },
    {
      "src": "/api/contacts",
      "dest": "/api/index"
    },
    {
      "src": "/api/contacts/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/init-kv",
      "dest": "/api/index"
    },
    {
      "src": "/debug/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/make-direct-call",
      "dest": "/api/index"
    },
    {
      "src": "/outgoing-call",
      "dest": "/api/index"
    },
    {
      "src": "/end-call",
      "dest": "/api/index"
    },
    {
      "src": "/start-recording",
      "dest": "/api/index"
    },
    {
      "src": "/stop-recording",
      "dest": "/api/index"
    },
    {
      "src": "/recording/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/delete-recording/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/call-status/(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/my-company",
      "dest": "/api/index"
    },
    {
      "src": "/plivo-(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/zadarma-(.*)",
      "dest": "/api/index"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}