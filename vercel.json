{
  "version": 2,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "/api/companies/register",
      "dest": "/api/companies.js"
    },
    {
      "src": "/api/companies/login",
      "dest": "/api/companies.js"
    },
    {
      "src": "/api/companies/(.*)",
      "dest": "/api/companies.js"
    },
    {
      "src": "/api/employees/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/voice",
      "dest": "/api/voice.js"
    },
    {
      "src": "/api/token",
      "dest": "/api/token.js"
    },
    {
      "src": "/api/recordings/(.*)",
      "dest": "/api/recordings.js"
    },
    {
      "src": "/api/recording-status",
      "dest": "/api/recording-status.js"
    },
    {
      "src": "/api/call-history",
      "dest": "/api/call-history.js"
    },
    {
      "src": "/api/contacts/(.*)",
      "dest": "/api/contacts.js"
    },
    {
      "src": "/api/work-tracking",
      "dest": "/api/work-tracking.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/token",
      "dest": "/api/token.js"
    },
    {
      "src": "/voice",
      "dest": "/api/voice.js"
    },
    {
      "src": "/recordings/(.*)",
      "dest": "/api/recordings.js"
    },
    {
      "src": "/recording/(.*)",
      "dest": "/api/recordings.js"
    },
    {
      "src": "/recording-status",
      "dest": "/api/recording-status.js"
    },
    {
      "src": "/work-tracking",
      "dest": "/api/work-tracking.js"
    },
    {
      "src": "/call-history",
      "dest": "/api/call-history.js"
    },
    {
      "src": "/contacts",
      "dest": "/api/contacts.js"
    },
    {
      "src": "/contacts/(.*)",
      "dest": "/api/contacts.js"
    },
    {
      "src": "/companies",
      "dest": "/api/companies.js"
    },
    {
      "src": "/companies/(.*)",
      "dest": "/api/companies.js"
    },
    {
      "src": "/login",
      "methods": [
        "POST",
        "GET",
        "PUT",
        "DELETE"
      ],
      "dest": "/api/index.js"
    },
    {
      "src": "/employees",
      "dest": "/api/index.js"
    },
    {
      "src": "/employees/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/account/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/balance",
      "dest": "/api/index.js"
    },
    {
      "src": "/heartbeat",
      "dest": "/api/index.js"
    },
    {
      "src": "/track-login",
      "dest": "/api/index.js"
    },
    {
      "src": "/track-logout",
      "dest": "/api/index.js"
    },
    {
      "src": "/online-users",
      "dest": "/api/index.js"
    },
    {
      "src": "/update-profile",
      "dest": "/api/index.js"
    },
    {
      "src": "/my-company",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/init-kv",
      "dest": "/api/index.js"
    },
    {
      "src": "/debug/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/make-direct-call",
      "dest": "/api/index.js"
    },
    {
      "src": "/outgoing-call",
      "dest": "/api/index.js"
    },
    {
      "src": "/end-call",
      "dest": "/api/index.js"
    },
    {
      "src": "/start-recording",
      "dest": "/api/index.js"
    },
    {
      "src": "/stop-recording",
      "dest": "/api/index.js"
    },
    {
      "src": "/delete-recording/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/call-status/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/settings",
      "dest": "/api/index.js"
    },
    {
      "src": "/plivo-(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/zadarma-(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}