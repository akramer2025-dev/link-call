{
  "version": 2,
  "name": "link-call",
  "routes": [
    {
      "src": "/(.*\\.(css|js|json|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|webmanifest))",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(platform|login|admin|register-company|super-admin|direct-call|test-crm-integration)\\.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    },
    {
      "src": "/api/companies/register",
      "methods": [
        "POST"
      ],
      "dest": "/api/companies.js"
    },
    {
      "src": "/api/companies/login",
      "methods": [
        "POST"
      ],
      "dest": "/api/companies.js"
    },
    {
      "src": "/api/companies/(.*)",
      "dest": "/api/companies.js"
    },
    {
      "src": "/api/employees/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/(voice|token|recordings|recording-status|call-history|contacts|work-tracking)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/token",
      "dest": "/api/token.js"
    },
    {
      "src": "/voice",
      "dest": "/api/voice.js"
    },
    {
      "src": "/recordings",
      "dest": "/api/recordings.js"
    },
    {
      "src": "/recordings/(.*)",
      "dest": "/api/recordings.js"
    },
    {
      "src": "/recording/(.*)",
      "dest": "/api/recordings.js"
    },
    {
      "src": "/work-tracking",
      "dest": "/api/work-tracking.js"
    },
    {
      "src": "/call-history",
      "dest": "/api/call-history.js"
    },
    {
      "src": "/contacts",
      "dest": "/api/contacts.js"
    },
    {
      "src": "/contacts/(.*)",
      "dest": "/api/contacts.js"
    },
    {
      "src": "/companies",
      "dest": "/api/companies.js"
    },
    {
      "src": "/companies/(.*)",
      "dest": "/api/companies.js"
    },
    {
      "src": "/login",
      "dest": "/api/index.js"
    },
    {
      "src": "/employees",
      "dest": "/api/index.js"
    },
    {
      "src": "/employees/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/account/balance",
      "dest": "/api/balance.js"
    },
    {
      "src": "/balance",
      "dest": "/api/balance.js"
    },
    {
      "src": "/account/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/heartbeat",
      "dest": "/api/heartbeat.js"
    },
    {
      "src": "/track-login",
      "dest": "/api/track-login.js"
    },
    {
      "src": "/track-logout",
      "dest": "/api/index.js"
    },
    {
      "src": "/online-users",
      "dest": "/api/index.js"
    },
    {
      "src": "/update-profile",
      "dest": "/api/index.js"
    },
    {
      "src": "/my-company",
      "dest": "/api/index.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/init-kv",
      "dest": "/api/index.js"
    },
    {
      "src": "/debug/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/make-direct-call",
      "dest": "/api/index.js"
    },
    {
      "src": "/outgoing-call",
      "dest": "/api/index.js"
    },
    {
      "src": "/end-call",
      "dest": "/api/index.js"
    },
    {
      "src": "/start-recording",
      "dest": "/api/index.js"
    },
    {
      "src": "/stop-recording",
      "dest": "/api/index.js"
    },
    {
      "src": "/delete-recording/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/call-status/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/settings",
      "dest": "/api/index.js"
    },
    {
      "src": "/plivo-(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/zadarma-(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}